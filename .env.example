# Public origin of the site (canonical URLs, sitemap, OpenGraph). Build-time only.
VITE_SITE_URL=https://baserastechtools.com

# Contact address shown on /contact (optional)
VITE_CONTACT_EMAIL=

# Google AdSense — keep disabled until you have real IDs from your AdSense account.
# With false, every ad position shows an "Advertisement" placeholder.
VITE_ADSENSE_ENABLED=false
# Format: ca-pub-XXXXXXXXXXXXXXXX (also used to generate /ads.txt)
VITE_ADSENSE_PUBLISHER_ID=
VITE_ADSENSE_TOP_SLOT=
VITE_ADSENSE_BOTTOM_SLOT=
VITE_ADSENSE_LEFT_SLOT=
VITE_ADSENSE_RIGHT_SLOT=

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Leave empty to disable analytics.
VITE_GOOGLE_ANALYTICS_ID=

# Host port for docker compose
WEB_PORT=8081
